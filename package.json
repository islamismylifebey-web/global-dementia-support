{
  "name": "global-dementia-support",
  "version": "0.1.0",
  "private": true,
  "description": "A worldwide directory of verified dementia support and care resources.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply global-dementia-support-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply global-dementia-support-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
